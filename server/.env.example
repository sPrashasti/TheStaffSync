# Copy this file to .env and fill in real values. Never commit .env.

# Environment: development | production
NODE_ENV=development

# Port the API listens on
PORT=5000

# MongoDB connection string (used from Phase 2)
# Local:  mongodb://127.0.0.1:27017/staffsync
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/staffsync
MONGO_URI=your_mongodb_connection_string

# Secret used to sign JWTs. At least 32 characters; the server will not start without it:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_secret
JWT_EXPIRES_IN=1d

# Company default time zone (IANA name) for attendance and leave dates. HR can give individual
# employees a different one. Defaults to Asia/Kolkata (IST) if unset.
TIMEZONE=Asia/Kolkata

# Frontend origin(s) allowed by CORS. Comma-separate multiple origins,
# e.g. http://localhost:5173,https://staffsync.example.com
CLIENT_URL=http://localhost:5173

# Seed script (npm run seed / npm run seed:demo). Creates the first HR account.
# Passwords: 8+ characters with at least one letter and one number.
SEED_HR_NAME=StaffSync HR
SEED_HR_EMAIL=hr@example.com
SEED_HR_PASSWORD=change_me_1
# Shared password for the demo accounts created by npm run seed:demo
SEED_DEMO_PASSWORD=change_me_2
