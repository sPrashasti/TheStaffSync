# Copy this file to .env and fill in real values. Never commit .env.

# Environment: development | production
NODE_ENV=development

# Port the API listens on
PORT=5000

# MongoDB connection string (used from Phase 2)
# Local:  mongodb://127.0.0.1:27017/staffsync
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/staffsync
MONGO_URI=your_mongodb_connection_string

# Secret used to sign JWTs. At least 32 characters; the server will not start without it:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_secret
JWT_EXPIRES_IN=1d

# Default time zone (IANA name) for NEW organisations. Each organisation's HR then sets its own
# (Company settings), and can give individual employees a different one. Asia/Kolkata if unset.
TIMEZONE=Asia/Kolkata

# Default working days for NEW organisations, comma-separated (Sun Mon Tue Wed Thu Fri Sat).
# Each organisation's HR can change its own.
WORKING_DAYS=Mon,Tue,Wed,Thu,Fri

# Frontend origin(s) allowed by CORS. Comma-separate multiple origins,
# e.g. http://localhost:5173,https://staffsync.example.com
CLIENT_URL=http://localhost:5173

# Seed script (npm run seed / npm run seed:demo). Creates the first HR account.
# Passwords: 8+ characters with at least one letter and one number.
SEED_HR_NAME=StaffSync HR
SEED_HR_EMAIL=hr@example.com
SEED_HR_PASSWORD=change_me_1
# Shared password for the demo accounts created by npm run seed:demo
SEED_DEMO_PASSWORD=change_me_2

# Security limits (optional; these are the defaults)
# LOGIN_MAX_FAILURES=5
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_MAX_REQUESTS=1000
# SIGNUP_MAX_PER_HOUR=10
# Number of proxies in front of the API when deployed (e.g. 1). Leave unset locally.
# TRUST_PROXY=1

# Email for "Forgot password". Any SMTP provider works. Without SMTP_HOST, development prints the
# email in the server terminal and production replies that email reset is unavailable.
# Microsoft 365: smtp.office365.com, 587 · Gmail: smtp.gmail.com, 587 (app password)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your_smtp_password
# MAIL_FROM=StaffSync <no-reply@example.com>
# Frontend address used in reset links (defaults to the first CLIENT_URL)
# APP_URL=https://staffsync.example.com
# RESET_TOKEN_MINUTES=30
# FORGOT_PASSWORD_MAX_PER_HOUR=5

# Optional: organisation for `npm run seed` when --organisation is not given.
# SEED_ORGANISATION=

# Only for `npm run platform:create-admin` (StaffSync operator account, not an organisation user).
# Remove it again after creating the admin.
# PLATFORM_ADMIN_PASSWORD=
