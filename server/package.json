{
  "name": "staffsync-server",
  "version": "1.0.0",
  "description": "StaffSync HR Management System — REST API (Node.js, Express, MongoDB)",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:indexes": "node scripts/syncIndexes.js",
    "seed": "node seed/seed.js",
    "seed:demo": "node seed/seed.js --demo",
    "clean:test-data": "node scripts/cleanTestData.js",
    "test": "node --test \"tests/*.test.js\"",
    "bench": "node scripts/benchmark.js",
    "migrate:tenancy": "node scripts/migrateTenancy.js",
    "platform:create-admin": "node scripts/createPlatformAdmin.js",
    "demo:setup": "node scripts/demo.js setup",
    "demo:reset": "node scripts/demo.js reset",
    "demo:status": "node scripts/demo.js status",
    "demo:disable": "node scripts/demo.js disable"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.0",
    "nodemailer": "^10.0.15"
  }
}
